cloud_id  = "b1g..."   # yc config get cloud-id
folder_id = "b1g..."   # yc config get folder-id
zone      = "ru-central1-a"

# sa_key_file = "~/.yc/terraform-key.json"   # or: export YC_TOKEN=$(yc iam create-token)

name_prefix          = "devops-14"
ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
ssh_private_key_path = "~/.ssh/id_ed25519"
ssh_allowed_cidrs    = ["0.0.0.0/0"]   # better: ["1.2.3.4/32"]
